<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NT.AvaloniaControl.Charts</PackageId>
    <AssemblyName>NT.AvaloniaControl.Charts</AssemblyName>
    <RootNamespace>NT.AvaloniaControl.Charts</RootNamespace>
    <Description>Preview Cartesian, statistical, financial, hierarchy, relationship, geographic and dashboard charts for Avalonia.</Description>
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="StbImageWriteSharp" />
    <None Update="README.md" Pack="true" PackagePath="/README.md" />
    <None Update="PACKAGE-README.md" Pack="true" PackagePath="/PACKAGE-README.md" />
    <None Update="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
