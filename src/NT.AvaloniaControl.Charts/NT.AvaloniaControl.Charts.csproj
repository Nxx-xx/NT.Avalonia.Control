<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NT.AvaloniaControl.Charts</PackageId>
    <AssemblyName>NT.AvaloniaControl.Charts</AssemblyName>
    <RootNamespace>NT.AvaloniaControl.Charts</RootNamespace>
    <Description>Independent Cartesian line, bar and scatter charts for Avalonia.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="StbImageWriteSharp" />
    <None Update="README.md" Pack="true" PackagePath="/README.md" />
    <None Update="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
