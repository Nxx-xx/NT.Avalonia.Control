<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="VirtualKeyboardFontSize">18</x:Double>
  <x:Double x:Key="VirtualKeyboardKeyMinWidth">32</x:Double>
  <x:Double x:Key="VirtualKeyboardKeyMinHeight">44</x:Double>
  <x:Double x:Key="VirtualKeyboardKeySpacing">6</x:Double>
  <CornerRadius x:Key="VirtualKeyboardCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="VirtualKeyboardKeyCornerRadius">6</CornerRadius>
  <Thickness x:Key="VirtualKeyboardPadding">10</Thickness>
  <Thickness x:Key="VirtualKeyboardKeyPadding">6,4</Thickness>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="VirtualKeyboardBackgroundBrush">#EDF2F7</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardForegroundBrush">#17212F</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardBorderBrush">#CAD5E2</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyBackgroundBrush">#FFFFFF</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyHoverBrush">#E1EDFA</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyPressedBrush">#BDD6F4</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyLockedBrush">#2464A5</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyLockedForegroundBrush">#FFFFFF</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyDisabledBrush">#E4E9EF</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyDisabledForegroundBrush">#788697</SolidColorBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="VirtualKeyboardBackgroundBrush">#17212F</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardForegroundBrush">#E7EEF7</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardBorderBrush">#405268</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyBackgroundBrush">#26364B</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyHoverBrush">#334D6A</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyPressedBrush">#42658C</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyLockedBrush">#8BBFFA</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyLockedForegroundBrush">#10243A</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyDisabledBrush">#202C3D</SolidColorBrush>
      <SolidColorBrush x:Key="VirtualKeyboardKeyDisabledForegroundBrush">#8495AB</SolidColorBrush>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
