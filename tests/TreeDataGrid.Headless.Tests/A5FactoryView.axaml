<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tg="clr-namespace:NT.AvaloniaControl.TreeDataGrid;assembly=NT.AvaloniaControl.TreeDataGrid"
             xmlns:local="clr-namespace:TreeDataGrid.Headless.Tests" x:Class="TreeDataGrid.Headless.Tests.A5FactoryView"
             x:DataType="local:A5Model">
  <tg:TreeDataGrid Name="FactoryGrid">
    <tg:TreeDataGrid.ElementFactory><local:A5RecordingFactory Name="xaml" /></tg:TreeDataGrid.ElementFactory>
    <tg:TreeDataGridTextColumn Header="Name" Binding="{CompiledBinding Name}" Width="160" />
  </tg:TreeDataGrid>
</UserControl>
