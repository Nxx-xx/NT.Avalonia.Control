<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="using:NT.AvaloniaControl.Charts" xmlns:local="using:Charts.Headless.Tests"
             x:Class="Charts.Headless.Tests.TemplateFeaturesConsumerView"
             x:DataType="local:TemplateFeaturesModel" x:CompileBindings="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="BusinessTemplateAccent" Color="#239FCB" />
    <DataTemplate x:Key="BusinessLegendTemplate" x:DataType="charts:ChartLegendItem">
      <Border Name="CompiledLegendRoot" Width="150" Height="32" Background="{DynamicResource BusinessTemplateAccent}">
        <TextBlock Name="CompiledSeriesTitle" Text="{Binding Series.Title}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="BusinessLabelTemplate" x:DataType="charts:ChartDataLabelContext">
      <Border Name="CompiledLabelRoot" Background="{DynamicResource BusinessTemplateAccent}">
        <StackPanel>
          <TextBlock Name="CompiledLabelText" Text="{Binding Text}" />
          <ContentControl Content="{Binding Data.Item}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="local:TemplateFeatureRow">
                <TextBlock Name="CompiledOriginalName" Text="{Binding Name}" />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <charts:CartesianChart x:Name="TemplateChart" LegendItemTemplate="{Binding LegendTemplate}"
                         IsLegendScrollable="True" LegendMaxHeight="80" LegendPosition="Bottom">
    <charts:CartesianChart.XAxis><charts:NumericAxis Minimum="0" Maximum="10" /></charts:CartesianChart.XAxis>
    <charts:CartesianChart.YAxis><charts:NumericAxis Minimum="0" Maximum="100" /></charts:CartesianChart.YAxis>
    <charts:CartesianChart.Series>
      <charts:ScatterSeries Title="{Binding Title}" ItemsSource="{Binding Records}" CategoryPath="X" ValuePath="Y" IdPath="Id"
                            ShowDataLabels="True" DataLabelTemplate="{Binding LabelTemplate}" />
    </charts:CartesianChart.Series>
  </charts:CartesianChart>
</UserControl>
