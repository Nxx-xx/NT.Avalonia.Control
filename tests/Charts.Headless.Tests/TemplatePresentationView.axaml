<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="using:NT.AvaloniaControl.Charts" xmlns:local="using:Charts.Headless.Tests"
             x:Class="Charts.Headless.Tests.TemplatePresentationView"
             x:DataType="local:TemplatePresentationModel" x:CompileBindings="True">
  <UserControl.Resources>
    <SolidColorBrush x:Key="TooltipTemplateBrush" Color="#1234AB" />
  </UserControl.Resources>
  <charts:CartesianChart x:Name="Chart" ShowLegend="False">
    <charts:CartesianChart.XAxis><charts:NumericAxis Minimum="0" Maximum="10" /></charts:CartesianChart.XAxis>
    <charts:CartesianChart.YAxis><charts:NumericAxis Minimum="0" Maximum="100" /></charts:CartesianChart.YAxis>
    <charts:CartesianChart.Series>
      <charts:ScatterSeries Title="{Binding Title}" ItemsSource="{Binding Records}" CategoryPath="X" ValuePath="Y" />
    </charts:CartesianChart.Series>
    <charts:CartesianChart.TooltipContentTemplate>
      <DataTemplate x:DataType="charts:ChartTooltipContext">
        <Border Name="CompiledTooltipContent" Background="{DynamicResource TooltipTemplateBrush}">
          <StackPanel>
            <TextBlock Name="TooltipSeriesTitle" Text="{Binding Primary.Series.Title}" />
            <TextBlock Name="TooltipContextText" Text="{Binding Text}" />
            <ContentControl Content="{Binding Primary.Item}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="local:TooltipTemplateRow">
                  <TextBlock Name="TooltipOriginalName" Text="{Binding Name}" />
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
          </StackPanel>
        </Border>
      </DataTemplate>
    </charts:CartesianChart.TooltipContentTemplate>
  </charts:CartesianChart>
</UserControl>
