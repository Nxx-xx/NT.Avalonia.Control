<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="using:NT.AvaloniaControl.Charts" xmlns:local="using:Charts.Headless.Tests"
             x:Class="Charts.Headless.Tests.ShapeAnnotationsConsumerView" x:DataType="local:ShapeAnnotationModel" x:CompileBindings="True">
  <UserControl.Resources><SolidColorBrush x:Key="ShapeInk" Color="#CB11A5" /></UserControl.Resources>
  <charts:CartesianChart x:Name="ShapeChart" ShowLegend="False" AnnotationsSource="{Binding Items}">
    <charts:CartesianChart.XAxis><charts:NumericAxis Minimum="0" Maximum="10" /></charts:CartesianChart.XAxis>
    <charts:CartesianChart.YAxis><charts:NumericAxis Minimum="0" Maximum="10" /></charts:CartesianChart.YAxis>
    <charts:CartesianChart.Annotations>
      <charts:RectangleAnnotation X1="{Binding Left}" Y1="2" X2="8" Y2="8" Fill="{DynamicResource ShapeInk}" />
    </charts:CartesianChart.Annotations>
  </charts:CartesianChart>
</UserControl>
