public sealed class ConsumerViewModel : INotifyPropertyChanged
{
    private string? _documentPath;
    private int _page = 1;

    public string? DocumentPath
    {
        get => _documentPath;
        set
        {
            if (_documentPath == value) return;
            _documentPath = value;
            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(DocumentPath)));
        }
    }
    public int Page
    {
        get => _page;
        set
        {
            if (_page == value) return;
            _page = value;
            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(Page)));
        }
    }
    public event PropertyChangedEventHandler? PropertyChanged;
}
