<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pdf="clr-namespace:NT.AvaloniaControl.PdfViewer;assembly=NT.AvaloniaControl.PdfViewer"
        xmlns:local="clr-namespace:PdfPackageConsumer"
        x:Class="PdfPackageConsumer.ConsumerWindow"
        x:DataType="local:ConsumerViewModel"
        Width="1180" Height="820">
  <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="8">
    <TextBlock Text="{Binding DocumentPath}" TextTrimming="CharacterEllipsis" />
    <pdf:PdfViewer Name="Reader" Grid.Row="1"
                   Source="{Binding DocumentPath}"
                   CurrentPage="{Binding Page, Mode=TwoWay}"
                   IsSidebarVisible="True" />
  </Grid>
</Window>
