<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefineConstants>$(DefineConstants);__SYMBOLS__</DefineConstants>
    <AssemblyName>Charts.PreviewConsumer</AssemblyName>
    <RuntimeIdentifier>__RID__</RuntimeIdentifier><SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed><PublishSingleFile>false</PublishSingleFile><PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    __PACKAGES__
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
  </ItemGroup>
</Project>
